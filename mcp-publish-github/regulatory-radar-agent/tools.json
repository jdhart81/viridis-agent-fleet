      "name": "build_evidence_pack",
      "description": "Build a live, source-hashed regulatory change evidence pack.\n\nFetches only the product's registry-owned regulator URLs, reports source\nretrieval timestamps and SHA-256 hashes, distinguishes a first baseline\nfrom a detected change, emits a bounded text diff on later changes, and\ncombines the evidence with a curated deadline calendar. Screening only;\nconfirm legal applicability with the cited authority or qualified counsel.",
      "inputSchema": {
        "properties": {
          "jurisdiction": {
            "title": "Jurisdiction",
            "type": "string"
          },
          "topics": {
