# Credentials are issued by the402 during provider onboarding.
# Store them only in the isolated production environment; never commit values.
THE402_API_KEY=
THE402_WEBHOOK_SECRET=

# Set after the Regulatory Radar listing is created.
THE402_SERVICE_ID=

THE402_STATE_DB=/state/the402_regulatory_radar.sqlite3
RADAR_PACKAGE_ROOT=/opt/viridis/regulatory-radar-agent
THE402_API_BASE=https://api.the402.ai
THE402_AUTO_REPLY=1
THE402_REQUEST_TIMEOUT_SECONDS=10
