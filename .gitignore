*.log
logs/

# Cache files that might store credentials
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pip-cache/
*.cache
.cache/

# IDE files that might contain secrets
.vscode/settings.json
.vscode/launch.json
.idea/
*.iml

# Mac OS files
.DS_Store
.AppleDouble
.LSOverride

# Temporary files
*.tmp
*.temp
~*
*~
.tmp/

# Package manager files with potential secrets
package-lock.json (review before committing)
yarn.lock (review before committing)
Pipfile.lock (review before committing)
