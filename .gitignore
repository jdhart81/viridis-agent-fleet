# === SECRETS & CREDENTIALS ===
# The env/ folder holds live keys — NEVER commit any of it.
env/
**/env/
*stripe*key*
*sk_live_*
*sk_test_*

# API Keys, tokens, and passwords (NEVER commit these)
*-key.txt
*-secret.txt
*-token.txt
*-credential.txt
*-password.txt
*.pem
*.key
*.pub
*.pgp

# Environment variables
.env
.env.local
.env.*.local
.env.production.local
.env.development.local
.env.test.local

# Stripe keys
stripe-key.txt
stripe-secret.txt

# AWS credentials
.aws/credentials
.aws/config
aws-credentials.json

# GCP/Firebase
*-serviceAccountKey.json
firebase-adminsdk-*.json
gcp-*.json

# Azure credentials
azure-credentials.json
.azure/

# API keys and tokens
api-key.txt
api-keys.json
api_key.json
api_keys.txt
*_api_key*
*-apikey-*

# OAuth tokens
*.token
oauth-tokens.json
refresh_token.txt

# Passwords and passphrases
password*.txt
passwd*.txt
pass*.txt
credentials.json
secrets.json
