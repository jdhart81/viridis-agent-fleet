{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robustness.local/schemas/decision-record.schema.json",
  "title": "Robustness Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engine_version",
    "status",
    "case_id",
    "case_version",
    "evaluation_time",
    "comparison_mode",
    "dominance_rule",
    "input_hashes",
    "lineage_summary",
    "claim_ledger",
    "epistemic_summary",
    "issues",
    "evaluations",
    "admissible_candidates",
    "pareto_frontier",
    "selected_candidate",
    "action_boundary",
    "record_sha256"
  ],
  "properties": {
    "engine_version": { "type": "string" },
    "status": { "enum": ["DECISION", "DECISION_READY", "HOLD", "NO_ADMISSIBLE_OPTION"] },
    "case_id": { "type": ["string", "null"] },
    "case_version": { "type": ["string", "null"] },
    "evaluation_time": { "type": ["string", "null"], "format": "date-time" },
    "model_id": { "type": "string" },
    "comparison_mode": { "const": "ROBUST_INTERVAL_DOMINANCE" },
    "dominance_rule": { "const": "WORST_CASE_NO_WORSE_THAN_OTHER_BEST_CASE" },
    "input_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_sha256", "outcomes_sha256"],
      "properties": {
        "case_sha256": { "$ref": "#/$defs/sha256" },
        "outcomes_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "lineage_summary": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identity_rule",
            "recall_policy",
            "evaluated_at",
            "model_artifact_id",
            "adapter_artifact_ids",
            "required_artifact_ids",
            "artifacts",
            "active_artifact_ids",
            "recalled_artifact_ids",
            "quarantined_artifact_ids",
            "pending_recall_artifact_ids",
            "blocked_required_artifact_ids",
            "decision_usable"
          ],
          "properties": {
            "identity_rule": { "const": "sha256(canonical_json({kind,manifest,parent_ids_sorted}))" },
            "recall_policy": { "const": "RECALL_CASCADES_TO_ALL_DESCENDANTS" },
            "evaluated_at": { "type": "string", "format": "date-time" },
            "model_artifact_id": { "$ref": "#/$defs/contentAddress" },
            "adapter_artifact_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/contentAddress" }
            },
            "required_artifact_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/contentAddress" }
            },
            "artifacts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["artifact_id", "kind", "parent_ids", "effective_state", "tainted_by", "recall"],
                "properties": {
                  "artifact_id": { "$ref": "#/$defs/contentAddress" },
                  "kind": {
                    "enum": [
                      "MODEL",
                      "ADAPTER",
                      "DATASET",
                      "EVIDENCE_SET",
                      "CONFIGURATION",
                      "SIMULATION_RECEIPT"
                    ]
                  },
                  "parent_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/contentAddress" }
                  },
                  "effective_state": { "enum": ["ACTIVE", "RECALLED", "QUARANTINED"] },
                  "tainted_by": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/contentAddress" }
                  },
                  "recall": {
                    "oneOf": [
                      { "type": "null" },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["reason", "authority", "effective_at"],
                        "properties": {
                          "reason": { "type": "string" },
                          "authority": { "type": "string" },
                          "effective_at": { "type": "string", "format": "date-time" }
                        }
                      }
                    ]
                  }
                }
              }
            },
            "active_artifact_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/contentAddress" }
            },
            "recalled_artifact_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/contentAddress" }
            },
            "quarantined_artifact_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/contentAddress" }
            },
            "pending_recall_artifact_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/contentAddress" }
            },
            "blocked_required_artifact_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/contentAddress" }
            },
            "decision_usable": { "type": "boolean" }
          }
        }
      ]
    },
    "claim_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "statement", "scope", "asserted_states", "unasserted_states", "limitations"],
        "properties": {
          "claim_id": { "type": "string" },
          "statement": { "type": "string" },
          "scope": { "type": "string" },
          "asserted_states": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "evidence_refs", "evidence_classes", "basis"],
              "properties": {
                "state": { "$ref": "#/$defs/claimState" },
                "evidence_refs": { "type": "array", "items": { "type": "string" } },
                "evidence_classes": { "type": "array", "items": { "type": "string" } },
                "basis": { "type": "string" }
              }
            }
          },
          "unasserted_states": { "type": "array", "items": { "$ref": "#/$defs/claimState" } },
          "limitations": { "type": "string" }
        }
      }
    },
    "epistemic_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claims_evaluated", "asserted_count_by_state", "implication_policy", "inference_edges"],
      "properties": {
        "claims_evaluated": { "type": "integer", "minimum": 0 },
        "asserted_count_by_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ASSUMED",
            "HYPOTHESIZED",
            "NUMERICALLY_SUPPORTED",
            "REPRODUCED",
            "FORMALLY_PROVED",
            "EMPIRICALLY_SUPPORTED",
            "AUTHORIZED",
            "DEPLOYED",
            "OBSERVED"
          ],
          "properties": {
            "ASSUMED": { "type": "integer", "minimum": 0 },
            "HYPOTHESIZED": { "type": "integer", "minimum": 0 },
            "NUMERICALLY_SUPPORTED": { "type": "integer", "minimum": 0 },
            "REPRODUCED": { "type": "integer", "minimum": 0 },
            "FORMALLY_PROVED": { "type": "integer", "minimum": 0 },
            "EMPIRICALLY_SUPPORTED": { "type": "integer", "minimum": 0 },
            "AUTHORIZED": { "type": "integer", "minimum": 0 },
            "DEPLOYED": { "type": "integer", "minimum": 0 },
            "OBSERVED": { "type": "integer", "minimum": 0 }
          }
        },
        "implication_policy": { "const": "NONE" },
        "inference_edges": { "type": "array", "maxItems": 0 }
      }
    },
    "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
    "decision_rule": { "type": "string" },
    "selection_rule": { "enum": ["pareto_only", "unique_pareto", "lexicographic"] },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "candidate_name", "admissible", "gate_failures", "uncertainty_holds", "breaches", "trajectory_analysis", "profile", "profile_intervals", "fragility_ledger"],
        "properties": {
          "candidate_id": { "type": "string" },
          "candidate_name": { "type": "string" },
          "admissible": { "type": "boolean" },
          "gate_failures": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "message", "details"],
              "properties": {
                "code": { "type": "string" },
                "message": { "type": "string" },
                "details": { "type": "object" }
              }
            }
          },
          "uncertainty_holds": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "message", "details"],
              "properties": {
                "code": {
                  "enum": [
                    "NON_COMPENSABLE_INTERVAL_UNCERTAIN",
                    "NON_COMPENSABLE_TRAJECTORY_UNCERTAIN",
                    "TRAJECTORY_COVERAGE_BELOW_FLOOR"
                  ]
                },
                "message": { "type": "string" },
                "details": { "type": "object" }
              }
            }
          },
          "breaches": { "type": "array", "items": { "type": "object" } },
          "trajectory_analysis": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "candidate_id",
                "scenario_id",
                "invariant_id",
                "stakeholder_id",
                "scale",
                "basis",
                "interpolation",
                "segment_policy",
                "sample_count",
                "observed_span_hours",
                "worst_point_margin",
                "worst_margin_interval",
                "possible_violation_span_hours",
                "robust_violation_span_hours",
                "declared_linear_shortfall_area",
                "guaranteed_recovery_elapsed_hours",
                "aftershock_count",
                "samples"
              ],
              "properties": {
                "candidate_id": { "type": "string" },
                "scenario_id": { "type": "string" },
                "invariant_id": { "type": "string" },
                "stakeholder_id": { "type": "string" },
                "scale": { "type": "string" },
                "basis": { "type": "string" },
                "interpolation": { "const": "PIECEWISE_LINEAR_BETWEEN_DECLARED_SAMPLES" },
                "segment_policy": { "const": "CONSERVATIVE_ENDPOINT_STATE_SPAN" },
                "sample_count": { "type": "integer", "minimum": 2 },
                "observed_span_hours": { "type": "number", "minimum": 0 },
                "worst_point_margin": { "type": "number" },
                "worst_margin_interval": { "$ref": "#/$defs/profileInterval" },
                "possible_violation_span_hours": { "type": "number", "minimum": 0 },
                "robust_violation_span_hours": { "type": "number", "minimum": 0 },
                "declared_linear_shortfall_area": { "type": "number", "minimum": 0 },
                "guaranteed_recovery_elapsed_hours": { "type": ["number", "null"], "minimum": 0 },
                "aftershock_count": { "type": "integer", "minimum": 0 },
                "samples": { "type": "array", "minItems": 2, "items": { "type": "object" } }
              }
            }
          },
          "profile": {
            "type": "object",
              "additionalProperties": { "type": ["number", "integer", "null"] }
          },
          "profile_intervals": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["lower", "upper", "provenance"],
                  "properties": {
                    "lower": { "type": "number" },
                    "upper": { "type": "number" },
                    "provenance": {
                      "enum": ["POINT_ESTIMATE", "DECLARED_INTERVAL", "DERIVED_INTERVAL"]
                    }
                  }
                }
              ]
            }
          },
          "fragility_ledger": {
            "type": "object",
            "required": ["direct_common_dependencies", "shared_failure_domains", "path_dependency_closures", "externalities", "irreversible_commitments"],
            "properties": {
              "direct_common_dependencies": { "type": "array", "items": { "type": "string" } },
              "shared_failure_domains": { "type": "array", "items": { "type": "string" } },
              "path_dependency_closures": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path_id", "direct_dependencies", "expanded_failure_domains"],
                  "properties": {
                    "path_id": { "type": "string" },
                    "direct_dependencies": { "type": "array", "items": { "type": "string" } },
                    "expanded_failure_domains": { "type": "array", "items": { "type": "string" } }
                  }
                }
              },
              "externalities": { "type": "array", "items": { "type": "object" } },
              "irreversible_commitments": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "admissible_candidates": { "type": "array", "items": { "type": "string" } },
    "pareto_frontier": { "type": "array", "items": { "type": "string" } },
    "selected_candidate": { "type": ["string", "null"] },
    "action_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_status", "executed", "selected_candidate", "authorized_actions", "authority_lease_id", "reasons"],
      "properties": {
        "execution_status": { "enum": ["AUTHORIZED_NOT_EXECUTED", "NOT_AUTHORIZED"] },
        "executed": { "const": false },
        "selected_candidate": { "type": ["string", "null"] },
        "authorized_actions": { "type": "array", "items": { "type": "string" } },
        "authority_lease_id": { "type": ["string", "null"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "selection_notes": { "type": "array", "items": { "type": "string" } },
    "dissent": { "type": "array", "items": { "type": "object" } },
    "record_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "contentAddress": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "profileInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper", "provenance"],
      "properties": {
        "lower": { "type": "number" },
        "upper": { "type": "number" },
        "provenance": {
          "enum": ["POINT_ESTIMATE", "DECLARED_INTERVAL", "DERIVED_INTERVAL"]
        }
      }
    },
    "claimState": {
      "enum": [
        "ASSUMED",
        "HYPOTHESIZED",
        "NUMERICALLY_SUPPORTED",
        "REPRODUCED",
        "FORMALLY_PROVED",
        "EMPIRICALLY_SUPPORTED",
        "AUTHORIZED",
        "DEPLOYED",
        "OBSERVED"
      ]
    },
    "issue": {
      "type": "object",
      "required": ["code", "message", "path"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "path": { "type": "string" }
      }
    }
  }
}
