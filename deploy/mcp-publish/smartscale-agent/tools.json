    {
      "name": "scale_objects_from_credit_card",
      "description": "Scale object pixel dimensions using a standard CR80 credit card reference.\n\nArgs:\n    image_id: Caller-defined source identifier; no image is uploaded.\n    credit_card_pixel_width: Caller-supplied pixel width of a CR80-size card.\n    objects: Objects to scale. Each object needs pixel_width and pixel_height;\n        label, pixel_area, pixel_perimeter, and input confidence are optional.\n    credit_card_pixel_height: Optional caller-supplied height for distortion check.\n    payment_ref: Optional paid escrow reference consumed by the gateway.\n    request_id: Optional retry-safe idempotency key (maximum 128 characters).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "image_id": {
            "type": "string"
          },
          "credit_card_pixel_width": {
            "type": "number"
          },
          "objects": {
            "type": "array"
          },
          "credit_card_pixel_height": {
            "type": "number"
          },
          "payment_ref": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "image_id",
          "credit_card_pixel_width",
          "objects"
        ]
      },
