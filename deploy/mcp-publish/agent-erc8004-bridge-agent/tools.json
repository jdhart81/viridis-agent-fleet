{
  "server": "agent-erc8004-bridge-agent",
  "tool_count": 10,
  "tools": [
    {
      "name": "import_registration",
      "description": "Import an ERC-8004 Identity Registry record (chain_id + ERC-721\n    token_id + agentURI + owner). Idempotent: re-import updates in place.\n    Returns the canonical record with its deterministic bridge DID\n    (did:viridis:erc8004:<chain>:<token>).",
      "inputSchema": {
        "properties": {
          "chain_id": {
            "title": "Chain Id",
            "type": "integer"
          },
          "token_id": {
            "title": "Token Id",
            "type": "integer"
          },
          "agent_uri": {
            "title": "Agent Uri",
            "type": "string"
          },
          "owner": {
            "title": "Owner",
            "type": "string"
          },
          "metadata": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Metadata"
          }
        },
        "required": [
          "chain_id",
          "token_id",
          "agent_uri",
          "owner"
        ],
        "title": "import_registrationArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "import_registrationOutput",
        "type": "object"
      }
    },
    {
      "name": "resolve_agent",
      "description": "Resolve an imported ERC-8004 registration by bridge DID or by\n    (chain_id, token_id).",
      "inputSchema": {
        "properties": {
          "bridge_did": {
            "default": "",
            "title": "Bridge Did",
            "type": "string"
          },
          "chain_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Chain Id"
          },
          "token_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Token Id"
          }
        },
        "title": "resolve_agentArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "resolve_agentOutput",
        "type": "object"
      }
    },
    {
      "name": "import_feedback",
      "description": "Import ERC-8004 Reputation Registry feedback records for an agent.\n    Each item: {value: bool|0..1, at: ISO-8601, source?, weight?, feedback_id?}.\n    Idempotent per feedback_id.",
      "inputSchema": {
        "properties": {
          "chain_id": {
            "title": "Chain Id",
            "type": "integer"
          },
          "token_id": {
            "title": "Token Id",
            "type": "integer"
          },
          "feedback": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Feedback",
            "type": "array"
          }
        },
        "required": [
          "chain_id",
          "token_id",
          "feedback"
        ],
        "title": "import_feedbackArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "import_feedbackOutput",
        "type": "object"
      }
    },
    {
      "name": "score_agent",
      "description": "Decay-weighted trust score in [0,1] + tier over the agent's imported\n    ERC-8004 feedback \u2014 recent behavior outweighs old; no feedback scores a\n    neutral 0.5 prior (no blind trust, no unfair zero).",
      "inputSchema": {
        "properties": {
          "bridge_did": {
            "default": "",
            "title": "Bridge Did",
            "type": "string"
          },
          "chain_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Chain Id"
          },
          "token_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Token Id"
          }
        },
        "title": "score_agentArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "score_agentOutput",
        "type": "object"
      }
    },
    {
      "name": "bind_identity",
      "description": "Bind a fleet DID to an ERC-8004 identity. Produces an order-independent,\n    content-addressed (unsigned) binding attestation.",
      "inputSchema": {
        "properties": {
          "fleet_did": {
            "title": "Fleet Did",
            "type": "string"
          },
          "chain_id": {
            "title": "Chain Id",
            "type": "integer"
          },
          "token_id": {
            "title": "Token Id",
            "type": "integer"
          },
          "proof_note": {
            "default": "",
            "title": "Proof Note",
            "type": "string"
          }
        },
        "required": [
          "fleet_did",
          "chain_id",
          "token_id"
        ],
        "title": "bind_identityArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "bind_identityOutput",
        "type": "object"
      }
    },
    {
      "name": "export_attestation",
      "description": "Export the agent's current trust score as an UNSIGNED\n    ERC-8004 Validation Registry-shaped payload, content-addressed and ready\n    for YOUR OWN signer to anchor on-chain.",
      "inputSchema": {
        "properties": {
          "chain_id": {
            "title": "Chain Id",
            "type": "integer"
          },
          "token_id": {
            "title": "Token Id",
            "type": "integer"
          }
        },
        "required": [
          "chain_id",
          "token_id"
        ],
        "title": "export_attestationArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "export_attestationOutput",
        "type": "object"
      }
    },
    {
      "name": "verify_attestation",
      "description": "Recompute a payload's content hash and report whether it is intact.",
      "inputSchema": {
        "properties": {
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          }
        },
        "required": [
          "payload"
        ],
        "title": "verify_attestationArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "verify_attestationOutput",
        "type": "object"
      }
    },
    {
      "name": "list_registrations",
      "description": "List all imported ERC-8004 registrations.",
      "inputSchema": {
        "properties": {},
        "title": "list_registrationsArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "list_registrationsOutput",
        "type": "object"
      }
    },
    {
      "name": "export_validation_response",
      "description": "Build UNSIGNED ERC-8004 Validation Registry validationResponse args\n    from an Outcome Receipt (ORC v0.1): responseHash = receipt commitment,\n    tag \"orc/0.1\", response 100 only if the bridge re-verifies the receipt\n    AND your replay succeeded. Sign and submit with your own signer; this\n    bridge holds no keys and writes to no chain.",
      "inputSchema": {
        "properties": {
          "receipt": {
            "additionalProperties": true,
            "title": "Receipt",
            "type": "object"
          },
          "request_hash": {
            "title": "Request Hash",
            "type": "string"
          },
          "response_uri": {
            "title": "Response Uri",
            "type": "string"
          },
          "replay_ok": {
            "title": "Replay Ok",
            "type": "boolean"
          }
        },
        "required": [
          "receipt",
          "request_hash",
          "response_uri",
          "replay_ok"
        ],
        "title": "export_validation_responseArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "export_validation_responseOutput",
        "type": "object"
      }
    },
    {
      "name": "describe_agent",
      "description": "Return the bridge's capabilities and input contract.",
      "inputSchema": {
