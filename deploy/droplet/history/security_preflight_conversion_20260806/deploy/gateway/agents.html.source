    :root{color-scheme:dark;--bg:#07140f;--panel:#10251c;--ink:#f3fff9;--muted:#a8c7b8;--green:#55e6a1;--line:#2a4d3d}*{box-sizing:border-box}body{margin:0;background:linear-gradient(140deg,#07140f 55%,#123b29);color:var(--ink);font:16px/1.5 system-ui,sans-serif}main{max-width:1180px;margin:auto;padding:64px 22px}a{color:var(--green)}h1{font-size:clamp(2.7rem,7vw,5.7rem);line-height:.96;max-width:1000px;margin:.25em 0}.lede{font-size:1.28rem;color:var(--muted);max-width:790px}.eyebrow{text-transform:uppercase;letter-spacing:.15em;color:var(--green);font-weight:800}.actions{display:flex;gap:12px;flex-wrap:wrap;margin:30px 0}.button{padding:13px 20px;border:1px solid var(--green);border-radius:999px;text-decoration:none;font-weight:800}.primary{background:var(--green);color:#052016}section{margin-top:56px}.wedge{background:linear-gradient(135deg,rgba(85,230,161,.14),rgba(16,37,28,.96));border:1px solid var(--green);border-radius:20px;padding:24px;max-width:900px}.wedge h2{margin-top:0}.wedge p{max-width:760px}.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:18px}table{border-collapse:collapse;width:100%;min-width:850px;background:rgba(16,37,28,.92)}th,td{text-align:left;padding:16px;border-bottom:1px solid var(--line);vertical-align:top}th{color:var(--green)}code{color:#d4f8e7}.trust{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:15px}.card{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:20px}.stat{font-size:2.3rem;font-weight:850;color:var(--green)}.gold402-badge{display:block;width:132px;height:20px;margin:0 0 14px}
