# Market-only runtime. This service receives no payment or wallet credential.
MARKET_PUBLIC_BASE=https://mcp.viridisconservation.com/network
MARKET_STATE_DB=/state/agent_market_network.sqlite3
MARKET_SEED_PROFILES=/app/seed_profiles.json
MARKET_HUB_REQUIRED=0
MARKET_HUB_URL=http://gateway:8402/internal/hub/events
# Generate a random 32+ byte value and set the same value on the gateway.
HUB_EVENT_SECRET=
# Public keys only. Example: {"viridis-security-injection-detector":"<Ed25519 raw public key, base64url>"}
MARKET_SECURITY_RECEIPT_KEYS_JSON={}
# Public keys only. Keep {} until a verifier and evidence-review process are deliberately approved.
MARKET_OPERATOR_VERIFICATION_KEYS_JSON={}
